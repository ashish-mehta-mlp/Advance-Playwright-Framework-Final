# Copy this file to .env and replace any YOUR_* placeholders you need.
# Never commit .env or put real credentials in this template.

# UI environment: qa, dev/local, stg/stage/staging, prod/production, or api
TTA_ENV=qa

# Optional UI URL overrides. BASE_URL overrides TTA_ENV selection.
# Uncomment only the URL you need and replace its placeholder.
# BASE_URL=YOUR_BASE_URL_HERE
# QA_BASE_URL=YOUR_QA_BASE_URL_HERE
# DEV_BASE_URL=YOUR_DEV_BASE_URL_HERE
# STG_BASE_URL=YOUR_STAGING_BASE_URL_HERE
# PROD_BASE_URL=YOUR_PRODUCTION_BASE_URL_HERE

# API and AI project base URL override
# API_BASE_URL=YOUR_API_BASE_URL_HERE

# Optional account values used by src/config/credentials.ts
# STANDARD_USER=YOUR_TEST_USERNAME_HERE
# TTA_SECRET=YOUR_TEST_PASSWORD_HERE

# Optional checkout test-data overrides
# CHECKOUT_FIRST_NAME=YOUR_FIRST_NAME_HERE
# CHECKOUT_LAST_NAME=YOUR_LAST_NAME_HERE
# CHECKOUT_POSTAL_CODE=YOUR_POSTAL_CODE_HERE

# Optional AI test configuration. A real key is required to run the Groq AI test.
# GROQ_API_KEY=YOUR_GROQ_API_KEY_HERE
# GROQ_MODEL=YOUR_GROQ_MODEL_HERE

# Optional report/log settings
# ATTACH_SCREENSHOTS=false
# LOG_LEVEL=info
# TEST_ENV=YOUR_REPORT_ENVIRONMENT_LABEL
# TEST_AUTHOR=YOUR_REPORT_AUTHOR_LABEL

# Optional provider keys checked by the custom reporter; keep real values secret.
# OPENAI_API_KEY=YOUR_OPENAI_API_KEY_HERE
# ANTHROPIC_API_KEY=YOUR_ANTHROPIC_API_KEY_HERE
# GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE
